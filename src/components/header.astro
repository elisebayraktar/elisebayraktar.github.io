---
import { Book, GraduationCap, Pencil, Presentation, User } from '@lucide/astro'

import ThemeToggle from '@/components/theme-toggle.astro'
import { type IconName, sections } from '@/lib/constants'

const icons: Record<IconName, typeof Book> = {
  Book,
  GraduationCap,
  Pencil,
  Presentation,
  User,
}
---

<header>
  <nav>
    <img alt="LPSM - Laboratoire de Probabilités, Statistiques et Modélisation" decoding="async" height="101" src="/images/lpsm.webp" width="200" />
    {
      sections.map(({ iconName, slug, title }) => {
        const Icon = icons[iconName]
        return (
          <a href={`#${slug}`}>
            <Icon />
            {title}
          </a>
        )
      })
    }
  </nav>
  <ThemeToggle />
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    background-color: var(--background);
    padding: 0.5rem 1rem;
    color: var(--foreground);
  }
  nav {
    display: flex;
    height: 4rem;
    align-items: center;
    gap: 0.5rem;
  }
  img {
    height: 2.5rem;
    width: auto;
    flex-shrink: 0;
  }
  nav a {
    display: none;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 0.375rem;
    padding-inline: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    transition: all 150ms;
  }
  nav a:hover {
    background-color: var(--accent);
    color: var(--accent-foreground);
  }
  nav a :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  @media (min-width: 768px) {
    nav {
      gap: 1rem;
    }
    nav a {
      display: inline-flex;
    }
  }
</style>
